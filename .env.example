APP_INFERENCE_MODE=pure
APP_MODEL_PATH_V1=model/orientation_model.onnx
APP_MODEL_PATH_V2=model/orientation_model_v2.onnx
APP_INFERENCE_THREADS=2
APP_HYBRID_CONFIDENCE_THRESHOLD=0.90
APP_HYBRID_MARGIN=0.25

# GenAI mode: server-side Gemini API key. Never commit your real .env file.
APP_GEMINI_API_KEY=
APP_GEMINI_MODEL=gemini-3.6-flash
APP_GEMINI_TIMEOUT_SECONDS=60
APP_GENAI_IMAGE_MAX_SIDE=1600
APP_GENAI_MAX_PDF_PAGES=10
